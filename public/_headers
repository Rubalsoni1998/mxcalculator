# Cloudflare static-asset headers (copied into dist/ by the build).
# HTML pages use Cloudflare's default (revalidate with ETag at the edge, answered as 304 without any code),
# so a deploy reaches visitors immediately and old pages never point at deleted fingerprinted files.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
# JS file names contain a content hash (build-dist.mjs), so they can be cached for a year.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
